<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp2.LoginPage"
             xmlns:ViewModel="clr-namespace:MauiApp2.ViewModels"
             x:DataType="ViewModel:LoginViewModel"
             Title="LoginPage">
    <VerticalStackLayout Padding="30" Spacing="15" VerticalOptions="Center">
        <Entry Placeholder="Masukkan Username"
               Text="{Binding Username}"/>
        <Entry Placeholder="MasukkanPassword"
               IsPassword="True"
               Text="{Binding Password}"/>
        <Label Text="{Binding ErrorMessage}"
               TextColor="Red"/>
        <Button Text="Login"
                Command="{Binding LoginCommand}"/>
    </VerticalStackLayout>
</ContentPage>