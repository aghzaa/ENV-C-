<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp2.DashboardPage"
             xmlns:vm="clr-namespace:MauiApp2.ViewModels"
             x:DataType="vm:DashboardViewModel"
             xmlns:models="clr-namespace:MauiApp2.Models"
             Title="DashboardPage">
    <ScrollView>
        
    <Grid RowDefinitions="Auto, Auto" RowSpacing="10">
        
        <Grid Grid.Row="0" HorizontalOptions="Center" ColumnDefinitions="Auto, Auto, Auto, Auto" Padding="15" ColumnSpacing="60">
            
            <Border Grid.Column="0"
                    Stroke="WhiteSmoke" 
                    StrokeShape="RoundRectangle 14" 
                    StrokeThickness="1" 
                    Padding="16 , 10"
                    MinimumWidthRequest="200"
                    MinimumHeightRequest="100"
                    BackgroundColor="Black">
                
                <Label Text="Hello World"
                       FontSize="20"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"
                       FontAttributes="Bold"/>
                
            </Border>

            <Border Grid.Column="1"
                    Stroke="WhiteSmoke" 
                    StrokeShape="RoundRectangle 14" 
                    StrokeThickness="1" 
                    Padding="16 , 10"
                    MinimumWidthRequest="200"
                    MinimumHeightRequest="100"
                    BackgroundColor="Black">
                
                <Label Text="Hello World"
                       FontSize="20"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"
                       FontAttributes="Bold"/>
                
            </Border>

            <Border Grid.Column="2"
                    Stroke="WhiteSmoke" 
                    StrokeShape="RoundRectangle 14" 
                    StrokeThickness="1" 
                    Padding="16 , 10"
                    MinimumWidthRequest="200"
                    MinimumHeightRequest="100"
                    BackgroundColor="Black">
                
                <Label Text="Hello World"
                       FontSize="20"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"
                       FontAttributes="Bold"/>
                
            </Border>

                <Border Grid.Column="3"
                    Stroke="WhiteSmoke" 
                    StrokeShape="RoundRectangle 14" 
                    StrokeThickness="1" 
                    Padding="16 , 10"
                    MinimumWidthRequest="200"
                    MinimumHeightRequest="100"
                    BackgroundColor="Black">

                    <Label Text="Hello World"
                       FontSize="20"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"
                       FontAttributes="Bold"/>

                </Border>
            </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*, 250" Padding="15" ColumnSpacing="30">
            
            <Border Grid.Row="0"
                    Stroke="White"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="1"
                    Padding="10,10"
                    BackgroundColor="Blue">

                    <Grid RowDefinitions="Auto,*" >

                        <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*" Padding="0,10">
                            <Label Grid.Column="0" HorizontalOptions="Center" Text="No" FontAttributes="Bold" />
                            <Label Grid.Column="1" HorizontalOptions="Center" Text="Username" FontAttributes="Bold" />
                            <Label Grid.Column="2" HorizontalOptions="Center" Text="Role" FontAttributes="Bold" />
                            <Label Grid.Column="3" HorizontalOptions="Center" Text="Aksi" FontAttributes="Bold" />
                        </Grid>

                        <CollectionView Grid.Row="1" ItemsSource="{Binding Users}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:User">
                                    <Grid ColumnDefinitions="*,*,*,*" Padding="0,10">
                                        <Label Grid.Column="0" HorizontalOptions="Center" Text="{Binding Id}" FontAttributes="Bold" />
                                        <Label Grid.Column="1" HorizontalOptions="Center" Text="{Binding Username}" FontAttributes="Bold" />
                                        <Label Grid.Column="2" HorizontalOptions="Center" Text="{Binding Role}" FontAttributes="Bold" />
                                        <Label Grid.Column="3" HorizontalOptions="Center" Text="Aksi" FontAttributes="Bold" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </Grid>

                </Border>

            <Border Grid.Column="1"
                    Stroke="White"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="1"
                    Padding="20,15"
                    BackgroundColor="Blue"
                    MinimumHeightRequest="350">
                
                <Grid RowDefinitions="Auto, Auto" Padding="5, 10" RowSpacing="20" >

                    <Label Grid.Row="0"
                       Text="Aksi Pintasan"
                       FontSize="20"
                       VerticalOptions="Start"
                       HorizontalOptions="Start"
                       FontAttributes="Bold"/>

                    <Grid Grid.Row="1" ColumnDefinitions="*, *" ColumnSpacing="10" RowDefinitions="Auto, Auto" RowSpacing="10">

                        <Border Grid.Column="0"
                                Grid.Row="0"
                                Stroke="White"
                                StrokeShape="RoundRectangle 14"
                                StrokeThickness="1"
                                BackgroundColor="Aquamarine"
                                MinimumHeightRequest="100">

                                <Button Text="Kelola User"
                                        Command="{Binding NavigateToKelolaUserCommand}">
                                    
                                </Button>
                            
                        </Border>

                        <Border Grid.Column="1"
                                Grid.Row="0"
                                Stroke="White"
                                StrokeShape="RoundRectangle 14"
                                StrokeThickness="1"
                                BackgroundColor="Aquamarine"
                                MinimumHeightRequest="100">

                                <Button Text="Click me">

                                </Button>

                            </Border>

                        <Border Grid.Column="0"
                                Grid.Row="1"
                                Stroke="White"
                                StrokeShape="RoundRectangle 14"
                                StrokeThickness="1"
                                BackgroundColor="Aquamarine"
                                MinimumHeightRequest="100">

                                <Button Text="Click me">

                                </Button>

                            </Border>

                        <Border Grid.Column="1"
                                Grid.Row="1"
                                Stroke="White"
                                StrokeShape="RoundRectangle 14"
                                StrokeThickness="1"
                                BackgroundColor="Aquamarine"
                                MinimumHeightRequest="1"
                                HeightRequest="80"
                                VerticalOptions="Start">

                                <Button Text="Click me">

                                </Button>

                            </Border>

                    </Grid>
                    
                </Grid>
                
            </Border>

        </Grid>
        
    </Grid>
        
    </ScrollView>
</ContentPage>